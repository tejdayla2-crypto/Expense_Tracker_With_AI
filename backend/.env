# .env — Environment Variables
# This file stores secret configuration. NEVER commit this to GitHub.
# Rename this file to .env and fill in your values.

# ─────────────────────────────────
# GEMINI API KEY (required for AI chat)
# Get yours free at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────
GEMINI_API_KEY=replace-with-your-gemini-api-key
JWT_SECRET=some-long-random-secret

# ─────────────────────────────────
# JWT Secret — used to sign login tokens
# Change this to any long random string (the longer the better)
# Example: openssl rand -base64 64
# ─────────────────────────────────
JWT_SECRET=ledger-super-secret-jwt-key-change-this-in-production-2024

# ─────────────────────────────────
# Server Config
# ─────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
